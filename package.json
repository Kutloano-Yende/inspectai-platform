{
  "name": "inspectai",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "dev:api": "pnpm --filter @inspectai/api dev",
    "dev:jobs": "pnpm --filter @inspectai/jobs dev",
    "dev:web": "pnpm --filter @inspectai/web dev",
    "test:e2e": "pnpm --filter @inspectai/e2e test"
  },
  "devDependencies": {
    "prisma": "^5.18.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  }
}
