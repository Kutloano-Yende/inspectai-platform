# API + jobs
DATABASE_URL=postgresql://inspectai:inspectai@localhost:5432/inspectai
REDIS_URL=redis://localhost:6379
PORT=4000

# S3-compatible storage (MinIO local / S3 in staging+)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=inspectai
S3_SECRET_KEY=inspectai-secret
S3_EVIDENCE_BUCKET=inspectai-evidence
S3_REPORTS_BUCKET=inspectai-reports

# Google sign-in (OAuth 2.0 Client ID, Google Cloud Console > APIs & Services > Credentials)
# Leave unset to leave the "Google" button on /login and /signup showing "not configured".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Apple sign-in (Sign in with Apple, requires a paid Apple Developer Program membership)
# Apple Developer > Certificates, Identifiers & Profiles:
#   APPLE_TEAM_ID       = your 10-character Team ID
#   APPLE_SERVICES_ID   = the Services ID (identifier) you registered as this app's client_id,
#                         with "Sign in with Apple" enabled and this redirect URI whitelisted
#   APPLE_KEY_ID         = the Key ID of a "Sign in with Apple" private key you generate there
#   APPLE_PRIVATE_KEY    = that key's .p8 file contents, newlines escaped as \n on one line
# Leave unset to leave the "Apple" button on /login and /signup showing "not configured".
APPLE_TEAM_ID=
APPLE_SERVICES_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/apple/callback

# Web app origin the API redirects back to after OAuth completes
WEB_APP_URL=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
