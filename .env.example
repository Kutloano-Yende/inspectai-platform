# API + jobs
DATABASE_URL=postgresql://inspectai:inspectai@localhost:5432/inspectai
REDIS_URL=redis://localhost:6379
PORT=4000

# S3-compatible storage (MinIO local / S3 in staging+)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=inspectai
S3_SECRET_KEY=inspectai-secret
S3_EVIDENCE_BUCKET=inspectai-evidence
S3_REPORTS_BUCKET=inspectai-reports

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
